{
  "name": "aether-monorepo",
  "version": "1.0.0",
  "description": "Aether - A unified, futuristic, and gamified experience across SwiftUI and React Native",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "type-check": "turbo run type-check",
    "docs:generate": "turbo run docs:generate",
    "docs:serve": "turbo run docs:serve",
    "analyze:bundles": "turbo run analyze:bundles",
    "publish:packages": "turbo run publish:packages",
    "publish:github-packages": "turbo run publish:github-packages",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "release:prepare": "turbo run release:prepare",
    "release:create": "turbo run release:create",
    "bundle:analyze": "turbo run bundle:analyze",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "validate:all": "npm run lint && npm run type-check && npm run test && npm run build"
  },
  "devDependencies": {
    "@aether/eslint-config": "file:packages/eslint-config",
    "@turbo/gen": "^1.10.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "eslint-plugin-react-native": "^4.0.0",
    "prettier": "^3.0.0",
    "react-test-renderer": "^18.2.0",
    "rimraf": "^5.0.0",
    "turbo": "^1.10.0",
    "typedoc": "^0.28.7",
    "typescript": "^5.0.0"
  },
  "packageManager": "npm@9.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chosone/aether-monorepo.git"
  },
  "keywords": [
    "aether",
    "react-native",
    "swiftui",
    "cross-platform",
    "ui-components",
    "design-system",
    "monorepo",
    "typescript"
  ],
  "author": "Aether Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/chosone/aether-monorepo/issues"
  },
  "homepage": "https://github.com/chosone/aether-monorepo#readme"
}
